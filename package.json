{
  "name": "cf-doh",
  "version": "1.2.0",
  "description": "⚡ High-performance, self-hosted DNS-over-HTTPS (RFC 8484) resolver on Cloudflare Workers with domain split-routing, trusted ECS injection, concurrent upstream racing, and interactive Web console.",
  "type": "module",
  "scripts": {
    "test": "node test/run-all.mjs",
    "build": "esbuild src/worker.js --bundle --format=esm --platform=browser --target=es2022 --outfile=dists/worker-single.js --log-level=warning",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start:dot": "node src/dot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dns",
    "doh",
    "dns-over-https",
    "dns-over-tls",
    "dot",
    "private-dns",
    "android",
    "cloudflare-workers",
    "serverless",
    "edns-client-subnet",
    "smartdns",
    "privacy",
    "rfc8484",
    "rfc7858",
    "speedup"
  ],
  "author": "dengyie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dengyie/cf-doh.git"
  },
  "bugs": {
    "url": "https://github.com/dengyie/cf-doh/issues"
  },
  "homepage": "https://github.com/dengyie/cf-doh#readme",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "wrangler": "^4.0.0"
  }
}
